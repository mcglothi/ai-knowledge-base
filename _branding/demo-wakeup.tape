Output _branding/demo-wakeup.gif

Set BackgroundColor "#0C1522"
Set ForegroundColor "#F6F1E9"
Set FontFamily "JetBrains Mono"
Set FontSize 14
Set Width 1000
Set Height 560
Set Padding 20
Set TypingSpeed 50ms

# Show the command being typed
Type "python3 _tools/memory-pipeline/runtime_cli.py wake-up"
Sleep 500ms
Enter
Sleep 8s

# Hold on completed output so viewer can read it
Sleep 4s
