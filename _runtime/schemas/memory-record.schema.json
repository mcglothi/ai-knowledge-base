{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryRecord",
  "type": "object",
  "required": ["id", "source", "path", "date", "chunk_id", "score", "excerpt"],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string", "enum": ["event", "candidate", "canonical"] },
    "path": { "type": "string" },
    "status": { "type": "string" },
    "date": { "type": "string" },
    "chunk_id": { "type": "string" },
    "section_title": { "type": "string" },
    "section_level": { "type": "integer", "minimum": 0 },
    "score": { "type": "number" },
    "excerpt": { "type": "string" }
  },
  "additionalProperties": true
}
